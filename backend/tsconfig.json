{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "outDir": "../dist",
        "rewriteRelativeImportExtensions": true,
        "rootDir": "..",
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2023",
        "types": ["node"],
        "verbatimModuleSyntax": true
    },
    "include": ["./*.ts", "../shared/*.ts"]
}
